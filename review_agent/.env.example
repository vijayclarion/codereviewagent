# AI Code Review Agent - configuration example
#
# Copy to `.env` in the repository root and fill in real values.
# `.env` is gitignored. NEVER commit real credentials.
# In a validation build, the TFS_* values and SYSTEM_ACCESSTOKEN come from
# pipeline variables instead, and take precedence over anything here.

# --- TFS / Azure DevOps Server: always required ---
TFS_BASE_URL=https://devops.example.com/tfs/YourCollection
TFS_PROJECT=Your-Project
TFS_REPO=YourRepo
TFS_PR_ID=1
TFS_API_VERSION=6.0

# --- Authentication: exactly one mode ---
# Manual runs: a PAT with "Code (read & write)" scope.
# Pipeline runs: leave TFS_PAT empty and let SYSTEM_ACCESSTOKEN be injected
# by the build (requires "Allow scripts to access the OAuth token").
TFS_PAT=

# --- Shared checklists ---
CHECKLIST_REPO_URL=https://devops.example.com/tfs/YourCollection/Your-Project/_git/TestMarkDown
# CHECKLIST_REPO=TestMarkDown      # only if name derivation from the URL is wrong
CHECKLIST_PATH=/
CHECKLIST_FILE_PATTERN=*.md
# NOTE: the brief's default is `main`, but this collection integrates on `master`.
CHECKLIST_BRANCH=master

# --- AI provider ---
# LLM_PROVIDER: claude | openai | azure | ollama
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
# LLM_BASE_URL=                    # required for azure and ollama

# --- Behaviour ---
# Defaults are deliberately safe: preview, and never block a merge.
DRY_RUN=true
FAIL_ON_CONTRADICTION=false

# --- Review scope (optional; sensible defaults built in) ---
# Files never sent to the AI provider. Comma-separated globs.
# REVIEW_EXCLUDE_PATTERNS=
# extend (default) adds to the built-in list; replace discards it.
# REVIEW_EXCLUDE_MODE=extend
# REVIEW_MAX_FILES=40
# REVIEW_MAX_DIFF_LINES=3000
# Feature 007: the budget is tokens for a whole prompt. Under it, one call.
# LLM_MAX_PROMPT_TOKENS=120000
# LLM_MAX_OUTPUT_TOKENS=8192
# Optional extra cap on changed lines per call (was a 1200 default before 007).
# LLM_MAX_CHUNK_LINES=
# Price per million tokens; with both set every run prints its estimated cost.
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
# LLM_PRICE_CURRENCY=USD

# --------------------------------------------------------------------------
# The checklist repository (feature 003)
#
# The team's checklists are spreadsheets and Word documents, so a working copy
# of this repository is obtained on each run and every supported document in it
# is read into individually citable rules.
#
# Three older names are still accepted, so no working configuration has to be
# renamed: TFS_REPO_CODE_REVIEW_CodeReviewChecklistT, CHECKLIST_REPO, and the
# _git/<name> segment of CHECKLIST_REPO_URL.
# --------------------------------------------------------------------------
TFS_REPO_CODE_REVIEW_CodeReviewChecklist=CodeReviewChecklist

# Comma-separated, matched against the filename, recursive from CHECKLIST_PATH.
# Default: *.xlsx,*.docx . Adding a document needs no change here.
# Set this to *.md to use the plain-text checklist path instead.
#CHECKLIST_FILE_PATTERN=*.xlsx,*.docx

# Unset means the repository's own default branch, which is usually what you want.
#CHECKLIST_BRANCH=

# This collection answers 404 on every endpoint at the default 6.0.
TFS_API_VERSION=5.0

# --------------------------------------------------------------------------
# GitHub (feature 007). Set PLATFORM=github; the TFS settings above are then
# not required. Full guide: docs/github-setup.md
# --------------------------------------------------------------------------
# PLATFORM=github
# STORY_SOURCE=github-issues           # or none
# GH_REPOSITORY=owner/name
# GH_PR_NUMBER=                        # or pass --pr
# GH_TOKEN=                            # read; GITHUB_TOKEN and GIT_REPO_TOKEN also accepted
# GH_TOKEN_FOR_PR=                     # required only to post
# GH_API_URL=https://api.github.com    # GHE Server: https://<host>/api/v3
# GH_CHECKLIST_REPO=owner/checklists
# GH_CHECKLIST_TOKEN=                  # defaults to GH_TOKEN
# GH_AGENT_REPO=owner/agent            # not needed with --local
